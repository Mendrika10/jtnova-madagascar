# Copier ce fichier en .env.local puis renseigner les valeurs.
# .env.local est gitignoré : aucun secret ne doit entrer dans le dépôt.

# --- Public (exposé au navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- ImageKit : images des réalisations (voir docs/SPRINTS.md, sprint S4bis) ---
# URL endpoint et clé publique : exposées au navigateur.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=

# --- Serveur uniquement (ne jamais exposer côté client) ---
# IMAGEKIT_PRIVATE_KEY sert à signer les envois : serveur uniquement, jamais côté client.
IMAGEKIT_PRIVATE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CRON_SECRET=

# Sans NEXT_PUBLIC_SUPABASE_URL/ANON_KEY, le site fonctionne avec ses données de repli locales.
# Sans les variables ImageKit, le site public fonctionne toujours : seul l'upload d'images
# de l'admin est indisponible (il affiche une erreur explicite au lieu de planter).
