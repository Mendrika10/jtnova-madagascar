# Copier ce fichier en .env.local puis renseigner les valeurs.
# .env.local est gitignoré : aucun secret ne doit entrer dans le dépôt.

# --- Public (exposé au navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- ImageKit : images des réalisations (voir docs/SPRINTS.md, sprint S4bis) ---
# URL endpoint et clé publique : exposées au navigateur.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=

# --- Serveur uniquement (ne jamais exposer côté client) ---
# IMAGEKIT_PRIVATE_KEY sert à signer les envois : serveur uniquement, jamais côté client.
IMAGEKIT_PRIVATE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# --- Contact (S6) : envoi des e-mails via Gmail SMTP ---
# SMTP_PASS est un mot de passe d'application Google (https://myaccount.google.com/apppasswords,
# 2FA requise) — serveur uniquement, jamais dans le dépôt ni le chat.
# Sans SMTP_USER/SMTP_PASS, le site fonctionne normalement : les messages restent
# enregistrés en base, seuls les e-mails sont sautés (jamais de crash).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Destinataire(s) de la notification admin : une ou plusieurs adresses séparées
# par des virgules (« jtnova@…, admin@… »). Défaut : SMTP_USER lui-même.
CONTACT_TO_EMAIL=
# Accusé de réception à l'expéditeur : activé par défaut, CONTACT_AUTOREPLY=0 pour désactiver.
CONTACT_AUTOREPLY=
# Anti-spam (F6.7) : salt du hachage d'IP (défaut : dérivé du jour) et seuil de débit
# (défaut : 5 envois / 15 minutes par IP hachée).
CONTACT_IP_SALT=
CONTACT_RATE_LIMIT_MAX=
CONTACT_RATE_LIMIT_WINDOW_MIN=

# --- S8 : passage automatique en « lu » quand l'e-mail a été lu (IMAP) ---
# L'envoi est en SMTP (canal qui n'écoute rien) : c'est l'application qui
# interroge la boîte en IMAP pour lire le drapeau « lu ». On réutilise le mot
# de passe d'application Google de l'envoi — rien à créer de plus. Seule
# condition côté Gmail : IMAP activé (Paramètres → Transfert et POP/IMAP).
# Sans ces variables, la fonctionnalité s'arrête proprement : les statuts
# restent ceux de l'admin, aucune page ne casse.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_USER / IMAP_PASS : par défaut SMTP_USER / SMTP_PASS.
IMAP_USER=
IMAP_PASS=
# Délai minimal entre deux interrogations de la boîte (défaut : 60 secondes).
IMAP_SYNC_MIN_INTERVAL_SEC=

# Sans NEXT_PUBLIC_SUPABASE_URL/ANON_KEY, le site fonctionne avec ses données de repli locales.
# Sans les variables ImageKit, le site public fonctionne toujours : seul l'upload d'images
# de l'admin est indisponible (il affiche une erreur explicite au lieu de planter).
